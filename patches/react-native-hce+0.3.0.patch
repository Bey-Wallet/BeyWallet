+package com.reactnativehce.managers;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.AtomicFile;
+import org.json.JSONObject;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+
+public class PrefManager {
+  private static PrefManager instance = null;
+  private final static String PREF_LIB_SUFFIX = ".HCE_DATA";
+  private final SharedPreferences preferences;
+  private volatile boolean sessionEnabled = false;
+  private final AtomicFile pendingFile;
+
+  public PrefManager(Context applicationContext) {
+    this.pendingFile = new AtomicFile(new File(applicationContext.getNoBackupFilesDir(), "nfc-payment.json"));
+    this.preferences = applicationContext.getSharedPreferences(
+      applicationContext.getPackageName() + PREF_LIB_SUFFIX,
+      Context.MODE_PRIVATE
+    );
+  }
+
+  public static synchronized PrefManager getInstance(Context applicationContext) {
+    if (instance == null) {
+      instance = new PrefManager(applicationContext);
+    }
+
+    return instance;
+  }
+
+  public void setRequestId(String id) { preferences.edit().putString("requestId", id).commit(); }
+  public String getRequestId() { return preferences.getString("requestId", ""); }
+
+  public synchronized JSONObject getPending() throws Exception {
+    if (!pendingFile.getBaseFile().exists() && !new File(pendingFile.getBaseFile().getPath() + ".bak").exists()) return null;
+    return new JSONObject(new String(pendingFile.readFully(), StandardCharsets.UTF_8));
+  }
+  public synchronized boolean savePending(String requestId, String content) {
+    FileOutputStream stream = null;
+    try {
+      JSONObject existing = getPending();
+      if (existing != null) return requestId.equals(existing.getString("requestId")) && content.equals(existing.getString("content"));
+      byte[] digest = MessageDigest.getInstance("SHA-256").digest((requestId + "\n" + content).getBytes(StandardCharsets.UTF_8));
+      StringBuilder id = new StringBuilder();
+      for (byte b : digest) id.append(String.format("%02x", b & 255));
+      JSONObject value = new JSONObject();
+      value.put("id", id.toString()); value.put("requestId", requestId);
+      value.put("content", content); value.put("receivedAt", System.currentTimeMillis());
+      stream = pendingFile.startWrite();
+      stream.write(value.toString().getBytes(StandardCharsets.UTF_8));
+      pendingFile.finishWrite(stream);
+      JSONObject saved = getPending();
+      return saved != null && id.toString().equals(saved.getString("id"));
+    } catch (Exception failure) {
+      if (stream != null) pendingFile.failWrite(stream);
+      return false;
+    }
+  }
+  public synchronized boolean acknowledgePending(String id) throws Exception {
+    JSONObject pending = getPending();
+    if (pending == null || !id.equals(pending.getString("id"))) return false;
+    pendingFile.delete();
+    return !pendingFile.getBaseFile().exists() && !new File(pendingFile.getBaseFile().getPath() + ".bak").exists();
+  }
+
+  public Boolean exists() {
+    return preferences.contains("type");
+  }
+
+  public void setContent(String text) {
+    preferences.edit().putString("content", text).apply();
+  }
+
+  public String getContent() {
+    return preferences.getString("content", "");
+  }
+
+  public void setType(String text) {
+    preferences.edit().putString("type", text).apply();
+  }
+
+  public String getType() {
+    return preferences.getString("type", "");
+  }
+
+  public void setWritable(Boolean writable) {
+    preferences.edit().putBoolean("writable", writable).apply();
+  }
+
+  public Boolean getWritable() {
+    return preferences.getBoolean("writable", false);
+  }
+
+  public void setEnabled(Boolean enabled) {
+    sessionEnabled = enabled;
+    preferences.edit().putBoolean("enabled", enabled).apply();
+  }
+
+  public Boolean getEnabled() {
+    return sessionEnabled;
+  }
+}
