+package com.reactnativehce.apps.nfc;
+
+import java.util.Arrays;
+import java.util.BitSet;
+
+/** Bounded Type 4 file transport; incoming writes never mutate the advertised request. */
+public final class Type4File {
+  public interface Commit { boolean save(byte[] message); }
+  private static final byte[] OK = {(byte)0x90, 0};
+  private static final byte[] ERROR = {(byte)0x6A, (byte)0x80};
+  private final byte[] outgoing;
+  private final boolean writable;
+  private final Commit commit;
+  private final byte[] incoming = new byte[0x7FFF];
+  private final BitSet received = new BitSet(0x7FFF);
+  private int selected;
+  private boolean writing;
+
+  public Type4File(byte[] outgoing, boolean writable, Commit commit) {
+    if (outgoing.length > incoming.length) throw new IllegalArgumentException("NDEF capacity exceeded");
+    this.outgoing = outgoing.clone();
+    this.writable = writable;
+    this.commit = commit;
+  }
+
+  public void reset() { selected = 0; writing = false; received.clear(); }
+
+  public byte[] process(byte[] command) {
+    if (command == null || command.length < 5 || command[0] != 0) return ERROR;
+    int instruction = command[1] & 255;
+    if (instruction == 0xA4) {
+      selected = 0;
+      if (command.length != 7 || command[2] != 0 || (command[3] != 0x0C && command[3] != 0) || command[4] != 2 || command[5] != (byte)0xE1) return ERROR;
+      selected = command[6] == 3 ? 3 : command[6] == 4 ? 4 : 0;
+      return selected == 0 ? ERROR : OK;
+    }
+    int offset = ((command[2] & 255) << 8) | (command[3] & 255);
+    int length = command[4] & 255;
+    if (instruction == 0xB0) {
+      if (command.length != 5 || selected == 0) return ERROR;
+      if (length == 0) length = 256;
+      byte[] cc = {0,15,0x20,1,0,0,(byte)255,4,6,(byte)0xE1,4,0x7F,(byte)255,0,(byte)(writable ? 0 : 255)};
+      byte[] source = selected == 3 ? cc : outgoing;
+      if (offset >= source.length) return ERROR;
+      int count = Math.min(length, source.length - offset);
+      byte[] result = Arrays.copyOfRange(source, offset, offset + count + 2);
+      result[count] = OK[0]; result[count + 1] = OK[1];
+      return result;
+    }
+    if (instruction != 0xD6 || !writable || selected != 4 || length == 0 || command.length != length + 5 || offset + length > incoming.length) return ERROR;
+    if (offset == 0 && length >= 2 && command[5] == 0 && command[6] == 0) {
+      writing = true;
+      received.clear();
+      Arrays.fill(incoming, (byte)0);
+    }
+    // Also accept a complete NDEF written in a single UPDATE BINARY.
+    if (!writing && offset == 0 && length >= 2) { writing = true; received.clear(); }
+    if (!writing) return ERROR;
+    System.arraycopy(command, 5, incoming, offset, length);
+    received.set(offset, offset + length);
+    int nlen = ((incoming[0] & 255) << 8) | (incoming[1] & 255);
+    if (nlen == 0) return OK;
+    if (nlen > incoming.length - 2) return ERROR;
+    if (received.nextClearBit(0) < nlen + 2) return OK;
+    boolean saved = commit.save(Arrays.copyOfRange(incoming, 2, nlen + 2));
+    writing = false;
+    received.clear();
+    return saved ? OK : ERROR;
+  }
+}
